        "RICH_ORIGIN": 25,
        "WEALTHY_ORIGIN": 50
      },
      "slot": "FORMATIVE",
      "phase": "Formative",
      "groupId": "1569db4c-5a99-462d-80c3-28dadc016275"
    },
    {
      "id": "apprenticeship_electrician",
      "text": "They took up an apprenticeship as an electrician, balancing work and study. The hands-on experience taught them practical problem-solving skills and the value of technical expertise.",
      "provides": [
        "TRADES_SKILLS"
      ],
      "weights": {
        "DEFAULT": 1,
        "POOR_ORIGIN": 50,
        "WORKING_CLASS_ORIGIN": 50,
        "MIDDLE_CLASS_ORIGIN": 20,
        "RICH_ORIGIN": 10,
        "WEALTHY_ORIGIN": 1,
        "STATE_SUPPORT_HISTORY": 5
      },
      "slot": "FORMATIVE",
      "phase": "Formative",
      "groupId": "1569db4c-5a99-462d-80c3-28dadc016275"
    },
    {
      "id": "university_philosophy",
      "text": "They pursued a degree in philosophy, engaging deeply with theoretical concepts and ethical dilemmas. This academic journey cultivated their critical thinking and analytical skills.",
      "provides": [
        "DEGREE"
      ],
      "weights": {
        "DEFAULT": 1,
        "POOR_ORIGIN": 5,
        "WORKING_CLASS_ORIGIN": 10,
        "MIDDLE_CLASS_ORIGIN": 30,
        "RICH_ORIGIN": 50,
        "WEALTHY_ORIGIN": 40
      },
      "slot": "FORMATIVE",
      "phase": "Formative",
      "groupId": "1569db4c-5a99-462d-80c3-28dadc016275"
    },
    {
      "id": "school_leaver_retail",
      "text": "They joined a school leaver program in retail, combining work with professional qualifications. This experience honed their customer service skills and taught them the intricacies of business operations.",
      "provides": [
        "SHOP_SKILLS"
      ],
      "weights": {
        "DEFAULT": 1,
        "POOR_ORIGIN": 50,
        "WORKING_CLASS_ORIGIN": 50,
        "MIDDLE_CLASS_ORIGIN": 25,
        "RICH_ORIGIN": 1,
        "WEALTHY_ORIGIN": 1
      },
      "slot": "FORMATIVE",
      "phase": "Formative",
      "groupId": "1569db4c-5a99-462d-80c3-28dadc016275"
    },
    {
      "id": "skills_bootcamp_coding",
      "text": "They attended a skills bootcamp in coding, immersing themselves in intensive learning. This fast-tracked their entry into the tech industry and sharpened their programming abilities.",
      "provides": [
        "TECH_SKILLS"
      ],
      "weights": {
        "DEFAULT": 1,
        "POOR_ORIGIN": 10,
        "WORKING_CLASS_ORIGIN": 20,
        "MIDDLE_CLASS_ORIGIN": 50,
        "RICH_ORIGIN": 10,
        "WEALTHY_ORIGIN": 1
      },
      "slot": "FORMATIVE",
      "phase": "Formative",
      "groupId": "1569db4c-5a99-462d-80c3-28dadc016275"
    },
    {
      "id": "direct_employment_construction",
      "text": "They entered the workforce directly as a construction worker, gaining early experience in the building trade. This job taught them the importance of teamwork and physical endurance.",
