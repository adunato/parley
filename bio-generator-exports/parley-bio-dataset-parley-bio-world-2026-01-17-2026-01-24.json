  "formative": [
    {
      "id": "oxbridge_admission",
      "text": "They were accepted into either Oxford University, a prestigious achievement that brought both pride and pressure. The rigorous academic environment pushed them to excel but also introduced them to a world of high expectations and intense competition.",
      "provides": [
        "DEGREE",
        "ADVANCED_DEGREE"
      ],
      "weights": {
        "DEFAULT": 1,
        "POOR_ORIGIN": 1,
        "WORKING_CLASS_ORIGIN": 5,
